; RESET NIGHT — Godot 4 Android 3D third-person survival
config_version=5

[application]
config/name="RESET NIGHT"
run/main_scene="res://scenes/ui/MainMenu3D.tscn"
run/max_fps=60
config/features=PackedStringArray("4.3", "GL Compatibility")

[display]
window/size/viewport_width=1280
window/size/viewport_height=720
window/stretch/mode="canvas_items"
window/handheld/orientation=1

[rendering]
renderer/rendering_method="gl_compatibility"
renderer/rendering_method.mobile="gl_compatibility"
lights_and_shadows/directional_shadow/size=1024
lights_and_shadows/directional_shadow/size.mobile=1024
lights_and_shadows/positional_shadow/atlas_size=1024
lights_and_shadows/positional_shadow/atlas_size.mobile=1024
textures/default_filters/use_nearest_mipmap_filter=false
environment/defaults/default_clear_color=Color(0.019608, 0.023529, 0.031373, 1)

[autoload]
SaveManager="*res://scripts/save_manager.gd"
MobileInputManager="*res://scripts/mobile_input_manager.gd"
NetworkManager="*res://scripts/network_manager.gd"

[input]
move_forward={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":87)]}
move_back={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":83)]}
move_left={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":65)]}
move_right={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":68)]}
attack={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":32)]}
throw_molotov={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":81)]}
fire_shotgun={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":70)]}
reload={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":82)]}
toggle_flashlight={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":76)]}
interact={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":69)]}
use_first_aid={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":72)]}
toggle_inventory={"deadzone":0.2,"events":[Object(InputEventKey,"physical_keycode":73)]}
